.module {
  margin-top: 16rpx;
}

.module-head {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 0;
}

.sub {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0 6rpx 24rpx;
  border-top: 1px solid #f0f2f4;
  font-size: 24rpx;
}

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.overlay-card {
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 40rpx;
}
.overlay-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.overlay-detail { color: #6b7280; font-size: 24rpx; margin-bottom: 24rpx; }
.progress { height: 12rpx; background: #eef0f3; border-radius: 999rpx; overflow: hidden; }
.bar { width: 40%; height: 100%; background: #3b6fd4; border-radius: 999rpx; animation: slide 1.1s ease-in-out infinite; }
@keyframes slide { 0% { transform: translateX(-100%); } 100% { transform: translateX(250%); } }
