page {
  background: #f5f6f8;
  color: #16191d;
  font-size: 14px;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  padding: 20rpx 24rpx 60rpx;
}

.card {
  background: #fff;
  border: 1px solid #e6e8eb;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-head {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.card-head .title {
  font-size: 30rpx;
  font-weight: 600;
}

.muted {
  color: #6b7280;
  font-size: 24rpx;
}

.tiny {
  color: #8a9099;
  font-size: 22rpx;
}

.right {
  margin-left: auto;
  color: #6b7280;
  font-size: 22rpx;
}

.nav {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.nav-item {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1px solid #e6e8eb;
  color: #6b7280;
  font-size: 24rpx;
}

.nav-item.active {
  background: #3b6fd4;
  border-color: #3b6fd4;
  color: #fff;
}

.form-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.field {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.field input {
  border: 1px solid #e6e8eb;
  border-radius: 12rpx;
  padding: 8rpx 12rpx;
  min-width: 120rpx;
  color: #16191d;
  background: #fff;
}

.field input.small {
  width: 90rpx;
  text-align: center;
}

.row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-top: 1px solid #f0f2f4;
}

.row .name {
  flex: 1;
  font-size: 26rpx;
}

.row input {
  width: 96rpx;
  border: 1px solid #e6e8eb;
  border-radius: 12rpx;
  padding: 8rpx 6rpx;
  text-align: center;
  font-size: 26rpx;
}

.out {
  width: 80rpx;
  text-align: right;
  color: #3b6fd4;
  font-weight: 600;
  font-size: 24rpx;
}

.summary {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top: 1px solid #e6e8eb;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.summary .stat {
  font-size: 26rpx;
}

.summary .stat text {
  font-weight: 600;
  font-size: 32rpx;
}

.summary .actions {
  margin-left: auto;
  display: flex;
  gap: 12rpx;
}

.btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1px solid #e6e8eb;
  background: #fff;
  color: #16191d;
  font-size: 26rpx;
}

.btn.primary {
  background: #3b6fd4;
  border-color: #3b6fd4;
  color: #fff;
}

.btn.danger {
  color: #c94f4f;
  border-color: #f0d2d2;
}

.btn.small {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
}

.empty {
  text-align: center;
  color: #6b7280;
  padding: 80rpx 20rpx;
}

.chart {
  width: 100%;
  height: 380rpx;
}

.tabs {
  display: flex;
  gap: 10rpx;
  overflow-x: auto;
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.tab {
  display: inline-block;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1px solid #e6e8eb;
  background: #fff;
  color: #6b7280;
  font-size: 24rpx;
}

.tab.active {
  background: #3b6fd4;
  border-color: #3b6fd4;
  color: #fff;
}

.hr {
  height: 1px;
  background: #e6e8eb;
  margin: 20rpx 0;
}

.list-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1px solid #f0f2f4;
}

.list-row .main {
  flex: 1;
}

.list-row .actions {
  display: flex;
  gap: 8rpx;
}

.kpi {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}

.kpi .item {
  background: #fff;
  border: 1px solid #e6e8eb;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  min-width: 180rpx;
}

.kpi .item .v {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
}

.kpi .item .k {
  color: #6b7280;
  font-size: 22rpx;
}
